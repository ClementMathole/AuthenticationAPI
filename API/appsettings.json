{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "AuthenticationAPI",
    "Audience": "AuthenticationAPIClient",
    "AccessTokenMinutes": 15
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "HttpsRedirection": {
    "Enabled": false
  },
  "OpenApi": {
    "Enabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
